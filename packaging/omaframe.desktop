[Desktop Entry]
Type=Application
Name=Omaframe 智能相框
Comment=在桌面上显示本地图片/视频相框
Exec=omaframe
Icon=preferences-desktop-display
Terminal=false
# 桌面起来后稍等再启动：不与 Hyprland/omarchy 首屏争资源
Keywords=oma;omaframe;omf;zm;xk;zmxk;zhuomian;xiangkuang;zhuomianxiangkuang;frame;photo;picture;image;desktop;wallpaper;相框;照片;桌面;壁纸;
# 拼音首字母缩写便于应用菜单搜索（桌面相框 → zm / xk / zmxk）
X-GNOME-Autostart-Delay=4
X-GNOME-Autostart-Enabled=true
# 不弹通知、不阻塞会话启动
X-GNOME-Autostart-NoNotification=true
X-StartupNotify=false
# 不设 OnlyShowIn：systemd 拿 $XDG_CURRENT_DESKTOP（本机为 Hyprland）匹配它，
# 写 X-Hyprland / Hyprland 都对不上 → 单元被判 exec-condition 静默跳过、永不自启。
# 程序在非 Hyprland 下会优雅降级，故不限制桌面环境。
