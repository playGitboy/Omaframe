[Desktop Entry]
Type=Application
Name=Omaframe 智能相框
Comment=在桌面上显示本地图片/视频相框
Exec=/home/sen/.local/bin/omaframe
Icon=preferences-desktop-display
Terminal=false
# 桌面起来后稍等再启动：不与 Hyprland/omarchy 首屏争资源
X-GNOME-Autostart-Delay=4
X-GNOME-Autostart-Enabled=true
# 不弹通知、不阻塞会话启动
X-GNOME-Autostart-NoNotification=true
X-StartupNotify=false
OnlyShowIn=Hyprland;
